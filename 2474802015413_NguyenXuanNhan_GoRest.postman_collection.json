    {
      "name": "Positive_TCs",
      "item": [
        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Tạo User thành công (Status 201 Created)\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "// Trích xuất id tự động và lưu vào biến môi trường (API Chaining)",
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.id) {",
                  "    pm.environment.set(\"userId\", jsonData.id);",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"gender\": \"{{gender}}\",\n  \"email\": \"{{email}}\",\n  \"status\": \"{{status}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseurl}}/public/v2/users",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "public",
                "v2",
                "users"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Lấy thông tin User thành công (Status 200 OK)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Kiểm tra tên User khớp với dữ liệu CSV\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var expectedName = pm.iterationData.get(\"name\");",
                  "    if (expectedName) {",
                  "        pm.expect(jsonData.name).to.eql(expectedName);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseurl}}/public/v2/userId",
